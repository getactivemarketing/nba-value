# Production API URL. Call Railway directly, not via the Vercel /api rewrite:
# through the rewrite every visitor arrives from one of ~3 Vercel egress IPs,
# which defeats the API's per-visitor rate limit. (The rewrite stays in
# vercel.json for anything cached against the old relative path.)
VITE_API_URL=https://nba-value-production.up.railway.app/api/v1
